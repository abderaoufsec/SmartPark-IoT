# SmartPark-IoT backend environment (M3)
# Copy to .env and edit locally. .env is git-ignored; never commit real credentials.

# ---- PostgreSQL (required) ----
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=smartpark
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (SQLAlchemy async format)
# DATABASE_URL=postgresql+psycopg2://smartpark:change-me-in-production@localhost:5432/smartpark

# ---- API security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- MQTT (for the event consumer) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartpark

# ---- Facility / device identifiers ----
SMARTPARK_FACILITY_ID=fac-demo
SMARTPARK_DEVICE_ID=esp32-001