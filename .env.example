# SmartPark-IoT environment template
#
# STATUS (M0): no file in this repository reads these values yet. They are a
# forward-looking template for the milestones that introduce real services:
#   MQTT broker   -> milestone M2
#   PostgreSQL / FastAPI backend -> milestone M3
#   SvelteKit frontend -> milestone M4
# Until those milestones land, copying this file is unnecessary.
#
# Usage once services exist:
#   copy .env.example .env      # then edit .env locally
#   .env is git-ignored; never commit real credentials.

# ---- MQTT (planned M2) ---------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Facility/device identifiers used in topic names (see docs/architecture/overview.md)
SMARTPARK_FACILITY_ID=fac-demo
SMARTPARK_DEVICE_ID=esp32-001

# ---- PostgreSQL (planned M3) --------------------------------------------
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartpark
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Backend API (planned M3) -------------------------------------------
API_HOST=localhost
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=

# ---- Frontend (planned M4) ----------------------------------------------
PUBLIC_API_BASE_URL=http://localhost:8000
